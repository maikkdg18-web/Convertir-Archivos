# Copia este archivo a apps/web/.env.local y apps/mobile/.env
# (con el prefijo correspondiente a cada framework, ver notas abajo)

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui

# Solo usado por las Edge Functions (nunca lo expongas en el cliente):
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Notas:
# - En Next.js las variables públicas deben tener el prefijo NEXT_PUBLIC_
#   (ej. NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY)
# - En Expo deben tener el prefijo EXPO_PUBLIC_
#   (ej. EXPO_PUBLIC_SUPABASE_URL, EXPO_PUBLIC_SUPABASE_ANON_KEY)
